
# Express 서버
PORT=3001
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=itda

# API Keys
GROQ_API_KEY=
TMAP_APP_KEY=
GEMINI_API_KEY=
# 메뉴판 OCR에 쓸 Gemini 모델 (비우면 gemini-3.5-flash-lite). 공식 문서에서 현재 사용 가능한 이름을 확인하세요.
GEMINI_MODEL=
# (선택) 위 모델이 혼잡(503)하거나 한도 초과일 때 대신 쓸 예비 모델. 예: gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
# (선택) Gemini 호출 1회당 제한 시간(밀리초). 넘으면 바로 예비 모델로 전환. 기본 30000
GEMINI_TIMEOUT_MS=
# (선택) 제보된 메뉴판 사진을 임시 보관할 폴더. 비우면 backend/uploads/menu-photos
MENU_PHOTO_DIR=

# Voice navigation: enable TTS explicitly; credentials stay on the server.
GUIDE_GOOGLE_TTS_ENABLED=
GOOGLE_TTS_API_KEY=
# Default voice: ko-KR-Chirp3-HD-Aoede
GUIDE_GOOGLE_TTS_VOICE=
GUIDE_GOOGLE_TTS_DAILY_CHARS=
# Optional Google ADC instead of API key
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_QUOTA_PROJECT=
# Set a text model supported by your Groq account
GUIDE_TEXT_MODEL=
