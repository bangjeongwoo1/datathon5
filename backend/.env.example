
# Express 서버
PORT=3001
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=itda

# API Keys
GROQ_API_KEY=
TMAP_APP_KEY=
GEMINI_API_KEY=
# 메뉴판 OCR에 쓸 Gemini 모델 (비우면 gemini-3.5-flash-lite). 공식 문서에서 현재 사용 가능한 이름을 확인하세요.
GEMINI_MODEL=
# (선택) 위 모델이 혼잡(503)하거나 한도 초과일 때 대신 쓸 예비 모델. 예: gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
# (선택) Gemini 호출 1회당 제한 시간(밀리초). 넘으면 바로 예비 모델로 전환. 기본 30000
GEMINI_TIMEOUT_MS=
# (선택) 제보된 메뉴판 사진을 임시 보관할 폴더. 비우면 backend/uploads/menu-photos
MENU_PHOTO_DIR=
# (선택) 메뉴판 제보에서 가게 번호(merchant_id)를 확인할 "가게 목록" 테이블. 비우면 merchants
# 크롤링이 끝나 지도의 가게 목록을 staging 으로 바꾸는 날에 merchant_crawl_staging 으로 바꾸세요.
# (허용: merchants, merchant_crawl_staging)
MERCHANT_SOURCE_TABLE=

# 로그인·관리자 확인 (Supabase Auth). 프론트 .env.local 의 VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY 와 같은 값이다.
# anon(공개) 키만 쓰고, service_role 키는 절대 넣지 마세요.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 관리자 이메일(쉼표로 구분). 비워 두면 아무도 관리자가 아니다. (이메일 인증이 끝난 구글 계정만 인정)
ADMIN_EMAILS=

# Voice navigation: enable TTS explicitly; credentials stay on the server.
GUIDE_GOOGLE_TTS_ENABLED=
GOOGLE_TTS_API_KEY=
# Default voice: ko-KR-Chirp3-HD-Aoede
GUIDE_GOOGLE_TTS_VOICE=
GUIDE_GOOGLE_TTS_DAILY_CHARS=
# Optional Google ADC instead of API key
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_QUOTA_PROJECT=
# Set a text model supported by your Groq account
GUIDE_TEXT_MODEL=
