
# Express 서버
PORT=3001
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=itda

# API Keys
GROQ_API_KEY=
TMAP_APP_KEY=
GEMINI_API_KEY=
# 메뉴판 OCR에 쓸 Gemini 모델 (비우면 gemini-3.8-flash). 공식 문서에서 현재 사용 가능한 이름을 확인하세요.
GEMINI_MODEL=
# (선택) 위 모델이 혼잡(503)하거나 한도 초과일 때 대신 쓸 예비 모델. 예: gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
# (선택) Gemini 호출 1회당 제한 시간(밀리초). 넘으면 바로 예비 모델로 전환. 기본 30000
GEMINI_TIMEOUT_MS=
