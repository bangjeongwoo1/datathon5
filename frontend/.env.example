VITE_KAKAO_MAP_APP_KEY=KAKAO_MAP_APP_KEY
VITE_API_BASE_URL=http://localhost:3001
KAKAO_REST_API_KEY=REST_API_키

# Supabase Auth (Settings -> API에서 확인. anon/publishable 키만 사용 - service_role 키는 절대 넣지 말 것)
VITE_SUPABASE_URL=https://프로젝트ref.supabase.co
VITE_SUPABASE_ANON_KEY=본인_Supabase_anon_키

# 메뉴판 사진 올리기에 로그인을 요구할지. 로컬에서 로그인 없이 시험할 때만 false로 바꾸세요. (기본: 로그인 필요)
VITE_UPLOAD_REQUIRES_LOGIN=true

# 음성 안내는 서버 /api/guide-speech의 Chirp 3 HD Aoede를 사용한다.
# API 키는 여기에 넣지 않는다. 서버 설정이 필요하며, 기본값은 true이다.
VITE_GUIDE_GOOGLE_TTS=true
